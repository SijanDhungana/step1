# --- Database (Postgres) --------------------------------------------------
# Neon's free tier works out of the box. In the Neon dashboard open your
# project -> Connect, and copy BOTH connection strings:
#
#   DATABASE_URL -> the POOLED string (its host contains "-pooler"). The app uses this.
#   DIRECT_URL   -> the DIRECT string (same host without "-pooler"). Used by
#                   `prisma db push` / `prisma migrate`, which need a real session.
#
# Keep ?sslmode=require on both — Neon only accepts TLS connections.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Running your own local Postgres instead? Point both at it:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleet"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fleet"

# --- Auth -----------------------------------------------------------------
# Secret used to sign staff session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# How long a staff login stays valid, in hours.
SESSION_HOURS=12

# --- Seeded admin account -------------------------------------------------
# Created by `npm run seed` on first run. Change the password after logging in.
ADMIN_EMAIL="admin@rentals.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Fleet Admin"

# --- Timezone -------------------------------------------------------------
# All booking date/times are shown in this timezone. Defaults to the machine's.
# TZ="America/New_York"
