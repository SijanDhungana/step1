# --- Database -------------------------------------------------------------
# SQLite file, relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# Secret used to sign staff session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# How long a staff login stays valid, in hours.
SESSION_HOURS=12

# --- Seeded admin account -------------------------------------------------
# Created by `npm run seed` on first run. Change the password after logging in.
ADMIN_EMAIL="admin@rentals.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Fleet Admin"

# --- Timezone -------------------------------------------------------------
# All booking date/times are shown in this timezone. Defaults to the machine's.
# TZ="America/New_York"
